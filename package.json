{
  "name": "oh-my-coding-buddy",
  "version": "0.1.0",
  "private": true,
  "description": "OMCB — a terminal coding agent that talks directly to model APIs (Anthropic + OpenAI-compatible), with an interactive Ink TUI and a headless NDJSON print mode.",
  "type": "module",
  "license": "MIT",
  "keywords": ["cli", "coding-agent", "ai", "anthropic", "openai", "ink", "tui", "mcp"],
  "bin": {
    "omcb": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^7.0.4",
    "react": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
