{
  "//": "复制到 ~/.codingmalo/config.json（全局）或 <项目>/.codingmalo/config.json（项目级）。密钥用 ${env:XXX} 引用 .env，不要写明文。'model' 必须填你在该 provider 控制台里确切可用的模型 id（Coding Malo 原样发给 API，不做任何映射）。运行时用 /model <名字> 或 --model <名字> 切换。",

  "logo": "${env:HOME}/.codingmalo/logo.jpeg",
  "logoWidth": 22,
  "logoBg": "transparent",
  "splash": true,

  "defaultModel": "deepseek",

  "models": {
    "deepseek": {
      "provider": "anthropic",
      "model": "deepseek-v4-flash",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "apiKey": "${env:DEEPSEEK_API_KEY}"
    },
    "deepseek-r": {
      "provider": "anthropic",
      "model": "deepseek-reasoner",
      "baseUrl": "https://api.deepseek.com/anthropic",
      "apiKey": "${env:DEEPSEEK_API_KEY}"
    },
    "deepseek-oai": {
      "provider": "openai-compat",
      "model": "deepseek-v4-flash",
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "${env:DEEPSEEK_API_KEY}"
    },
    "gpt-4o": {
      "provider": "openai-compat",
      "model": "gpt-4o",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "${env:OPENAI_API_KEY}"
    },
    "opus": {
      "provider": "anthropic",
      "model": "claude-opus-4-8",
      "apiKey": "${env:ANTHROPIC_API_KEY}"
    }
  },

  "permissionMode": "acceptEdits",
  "sandbox": "workspace-write"
}
