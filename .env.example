# 复制为 .env（已被 gitignore），填入各 provider 的 API key。
# omcb 启动时会自动从工作目录加载 .env。
#
# 这里只放「密钥」；具体有哪些模型（provider / model / baseUrl）放在 config.json，
# 见 config.example.json —— config.json 用 ${env:XXX} 引用下面这些 key，所以可以安全提交。

# DeepSeek（同一把 key 可用于 /anthropic 兼容端点和 /v1 OpenAI 兼容端点）
DEEPSEEK_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic 官方
# ANTHROPIC_API_KEY=

# 网关（OpenRouter / LiteLLM / one-api 等）
# OPENROUTER_API_KEY=
