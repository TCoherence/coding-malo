# Copy this file to `.env` (which is gitignored) and fill in your values.
# omcb auto-loads `.env` from the working directory on startup.

# --- Anthropic (or an Anthropic-compatible gateway, e.g. DeepSeek's /anthropic endpoint) ---
ANTHROPIC_API_KEY=
# Optional gateway base URL, e.g. https://api.deepseek.com/anthropic
# ANTHROPIC_BASE_URL=

# --- OpenAI-compatible providers (OpenAI, DeepSeek /v1, OpenRouter, …) ---
# Use with `--provider openai-compat` (or OMCB_PROVIDER=openai-compat).
# OPENAI_API_KEY=
# OMCB_BASE_URL=https://api.deepseek.com

# --- Optional defaults ---
# OMCB_MODEL=deepseek-chat
# OMCB_PROVIDER=anthropic
